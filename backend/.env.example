# Copie este arquivo para .env e preencha com os dados do seu MySQL

PORT=3333

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_alunos

# Chave para assinar os tokens de login. Use um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRA_EM=2h
